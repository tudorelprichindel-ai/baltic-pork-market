{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galas-grozs-admin",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "ADMIN", "class_name": "Administration" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Administration"] }],
  "vars": {
    "GITHUB_REPOSITORY": "tudorelprichindel-ai/baltic-pork-market",
    "GITHUB_BRANCH": "main",
    "PUBLIC_SITE_URL": "https://www.galasgrozs.lv",
    "ADMIN_USER": "galasgrozs"
  },
  "observability": { "enabled": false }
}
